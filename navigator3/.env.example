# Скопируйте в .env и заполните. .env не попадает в git.
PUBLIC_BASE_URL=https://example.apigw.yandexcloud.net
# Дополнительные origin'ы через запятую (старый адрес шлюза, www и т.п.).
PUBLIC_ALTERNATE_URLS=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
SESSION_TTL_DAYS=30
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/xxxx/xxxx
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=your-bucket
S3_REGION=ru-central1
SERVICE_ACCOUNT_ID=xxxxxxx
# Премиум-подписка и ЮKassa.
# Цена в рублях и срок в днях.
PREMIUM_PRICE_RUB=299
PREMIUM_DAYS=30
# Магазин ЮKassa. Для тестового режима используйте тестовые shopId и секрет.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Реквизиты для страницы /legal.html (модерация ЮKassa).
LEGAL_NAME=
LEGAL_INN=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_TELEGRAM=
