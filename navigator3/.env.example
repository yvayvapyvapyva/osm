# Скопируйте в .env и заполните. .env не попадает в git.
PUBLIC_BASE_URL=https://example.apigw.yandexcloud.net
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
ROUTE_ADMIN_PASSWORD=
SESSION_TTL_DAYS=30
# shopId ЮKassa. Если пусто, оплата отключена и /api/orders отвечает 503.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/xxxx/xxxx
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=your-bucket
S3_REGION=ru-central1
SERVICE_ACCOUNT_ID=xxxxxxx
